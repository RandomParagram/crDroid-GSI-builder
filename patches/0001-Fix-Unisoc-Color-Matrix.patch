From 668dab3cae3bba60a4cf27eb44719750179875aa Mon Sep 17 00:00:00 2001
From: Richard Milton <aprilmonolog@gmail.com>
Date: Mon, 19 Oct 2026 13:30:57 +0700
Subject: [PATCH] fix: unisoc video feed color render

---
 .../surfaceflinger/CompositionEngine/src/Output.cpp   | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/services/surfaceflinger/CompositionEngine/src/Output.cpp b/services/surfaceflinger/CompositionEngine/src/Output.cpp
index 28250e0b07f..f02313c7843 100644
--- a/services/surfaceflinger/CompositionEngine/src/Output.cpp
+++ b/services/surfaceflinger/CompositionEngine/src/Output.cpp
@@ -265,7 +265,16 @@ void Output::setLayerFilter(LayerFilter filter) {
 void Output::setColorTransform(const compositionengine::CompositionRefreshArgs& args) {
     auto& colorTransformMatrix = editState().colorTransformMatrix;
     if (!args.colorTransformMatrix || colorTransformMatrix == args.colorTransformMatrix) {
-        return;
+        return; }
+        char value[PROPERTY_VALUE_MAX];
+        property_get("persist.sys.phh.disable_color_transform", value, "0");
+        bool disableColorTransform = (atoi(value) == 1 || !strcmp(value, "true"));
+
+        if (disableColorTransform) {
+            // Force matrix to an Identity Matrix
+            matrix = mat4(); 
+            return;
+        }
     }
 
     colorTransformMatrix = *args.colorTransformMatrix;
