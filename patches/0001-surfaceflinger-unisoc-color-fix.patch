From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Developer <developer@example.com>
Date: Mon, 19 Oct 2026 00:00:00 +0000
Subject: [PATCH] surfaceflinger: Bypass color transform for Unisoc drivers

---
 services/surfaceflinger/SurfaceFlinger.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index e1a2b3c..d4e5f6a 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -52,6 +52,7 @@
 #include <gui/BufferQueue.h>
 #include <gui/GuiConfig.h>
 #include <gui/IDisplayEventConnection.h>
+#include <cutils/properties.h>
 
 using namespace android::hardware::graphics::common;
 
@@ -2850,6 +2851,16 @@ void SurfaceFlinger::updateColorMatrixLocked() {
     mat4 colorMatrix;
     if (mGlobalColorTransform) {
         colorMatrix = mGlobalColorTransformMatrix;
+
+        // Workaround for Unisoc video color inversion bug
+        char prop[PROPERTY_VALUE_MAX];
+        property_get("persist.sys.phh.disable_color_transform", prop, "0");
+        if (strcmp(prop, "1") == 0 || strcmp(prop, "true") == 0) {
+            // Force identity matrix: pass untouched colors to hardware composer
+            colorMatrix = mat4();
+        }
     }
 
     for (const auto& [token, display] : mDisplays) {
--
